PORT=5000
# Leave empty to use the built-in database (no install needed).
# To use your own PostgreSQL server instead, set e.g.
# DATABASE_URL=postgres://skillswap:skillswap@localhost:5432/skillswap
DATABASE_URL=
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
# Optional: enables Redis caching of search results. Leave empty to use in-memory cache.
REDIS_URL=
STARTER_CREDITS=5
